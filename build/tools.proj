<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Downloads the tools used to package releases through NuGet, so nothing has to be installed
    system-wide. Only ever restored (build/package.ps1 runs `dotnet restore` on it), never built.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Tools.InnoSetup" Version="[6.7.3]" />
  </ItemGroup>

</Project>
